  "audit_findings": [
    {
      "id": "contact_reward",
      "status": "incorrect",
      "claim": "Standing in contact provides +10 per leg every timestep.",
      "correction": "Contact is a term in shaping; step reward uses shaping minus previous shaping, then engine costs. Unchanged contact provides no repeated +10.",
      "source": "https://github.com/Farama-Foundation/Gymnasium/blob/v1.1.1/gymnasium/envs/box2d/lunar_lander.py#L584-L599"
    },
    {
      "id": "collapse_causes",
      "status": "unsupported_causal_inference",
      "claim": "Overestimation, forgotten crash transitions and target updates caused the observed collapses.",
      "correction": "Retain observed reward changes; treat causes as hypotheses without Q-error, buffer composition measurements or controlled ablations."
    },
    {
      "id": "determinism",
      "status": "overstated",
      "claim": "Same seed guarantees exactly identical results.",
      "correction": "Seeds and one CPU thread support repeatability within a recorded runtime; no cross-version/platform/device equality has been established."
    },
    {
      "id": "training_underestimates",
      "status": "incorrect_generalization",
      "claim": "Training rewards systematically underestimate the agent due to residual epsilon.",
      "correction": "Historical seed7 last100 training248.0 exceeds historical greedy230.9. Checkpoints and episode distributions differ; epsilon-only causal attribution is untested."
    },
    {
      "id": "never_crashes",
      "status": "overgeneralized",
      "correction": "Limit claim to the sample; old helper aggregates crashes and leaving viewport."
    },
    {
      "id": "gamma_horizon",
      "status": "overstated",
      "correction": "1/(1-gamma) is an effective horizon, not hard zeroing after that many steps. Effects of gamma cannot be assigned causal mechanism from single-seed reward curves alone."
    },
    {
      "id": "dueling",
      "status": "incorrect_mechanism",
      "correction": "Dueling architecture and Double DQN are distinct extensions; do not call both direct overestimation corrections or claim guaranteed improvement."
    },
    {
      "id": "max_steps_attribution",
      "status": "attribution_correction",
      "correction": "500 steps were already configured in initial scaffold 6d9e28c; P4 implemented use in environment creation."
    },
    {
      "id": "historical_eval_artifacts",
      "status": "missing_raw_support",
      "correction": "Historical 28/30 truncations, 57% main engine actions and 37% crashes are stated in README but corresponding evaluation CSVs and sweep checkpoints are absent; label as historical reported numbers if retained."
    },
    {
      "id": "final_models",
      "status": "artifact_description",
      "correction": "Training saves future final checkpoints; repository contains only best_seed7/42/123.pt."
    }
  ],
